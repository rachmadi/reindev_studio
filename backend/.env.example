# ==============================================================================
# ReinDev Studio - Environment Configuration
# ==============================================================================

# Pilihan LLM Provider Utama: "ollama" (Lokal) atau "openrouter" (Cloud)
LLM_PROVIDER=ollama

# Konfigurasi Ollama (Lokal - Dioptimalkan untuk VRAM 6GB Resident)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.2

# Konfigurasi OpenRouter (Cloud)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REASONING_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_CODER_MODEL=deepseek/deepseek-chat

# Mode Pengujian Sandbox (true jika ingin uji deterministik tanpa memanggil LLM)
MOCK_LLM=false
